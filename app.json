{
  "expo": {
    "name": "Fastfast",
    "slug": "Fastfast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fastfast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kalect.fastfast"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-audio",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FastTimer",
              "label": "FastFast",
              "description": "Fasting timer, start button and today's mood",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FastCompact",
              "label": "FastFast mini",
              "description": "Fasting timer with a start/stop button",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "maxResizeWidth": "180dp",
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
